
# 通用
ENV=production
API_BASE_URL=http://127.0.0.1:8483
SCREENSHOT_BASE_URL=http://127.0.0.1:8483/static/screenshots
STATIC=/static # 外部访问路径（URL 前缀）
OUT_DIR=./static/screenshots    # 本地输出目录
IMAGE_BASE_URL=/static/screenshots  # 图片访问 URL
# 原片截图的质量把关参数（不填用默认值）
SCREENSHOT_MIN_TIMESTAMP=8      # 早于该秒数的标记跳过（避开片头黑屏）
SCREENSHOT_MIN_GAP_SECONDS=20   # 相邻两张的最小间隔，太密会被丢弃
SCREENSHOT_MAX_COUNT=20         # 全文截图数量上限
SCREENSHOT_MIN_BYTES=10240      # 图片小于该字节数视为黑屏/纯色，直接丢弃
DATA_DIR=data
# transcriber 相关配置
TRANSCRIBER_TYPE=fast-whisper # fast-whisper/bcut/kuaishou
WHISPER_MODEL_SIZE=base